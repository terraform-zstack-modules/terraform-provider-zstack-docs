zstack_host              = "zstack.example.com"
zstack_port              = 8080
zstack_access_key_id     = "replace-me"
zstack_access_key_secret = "replace-me"

vm_name                = "tf-init-demo"
image_name             = "Ubuntu-24.04"
l3_network_name        = "default-l3"
instance_offering_name = "small"
static_ip              = null

ssh_key_name   = "tf-admin-key"
ssh_public_key = "ssh-rsa replace-me"

script_name    = "tf-bootstrap"
script_content = "echo hello from terraform"
script_timeout = 180
