zstack_host              = "zstack.example.com"
zstack_port              = 8080
zstack_access_key_id     = "replace-me"
zstack_access_key_secret = "replace-me"

# The defaults are broad discovery patterns. Narrow them when the result list
# is too large for review.
image_name_pattern             = "%"
l3_network_name_pattern        = "%"
instance_offering_name_pattern = "%"
disk_offering_name_pattern     = "%"
zone_name_pattern              = "%"
cluster_name_pattern           = "%"
host_name_pattern              = "%"
