# Copy this file to .env and fill in only local authentication details.
# Keep resource names and UUIDs out of the shared .env whenever they can be
# discovered with Terraform data sources.
#
# From an example directory:
# source ../../../.env

export TF_VAR_zstack_host="zstack.example.com"
export TF_VAR_zstack_port=8080
export TF_VAR_zstack_access_key_id="replace-me"
export TF_VAR_zstack_access_key_secret="replace-me"
